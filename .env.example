# Salin file ini menjadi ".env" lalu sesuaikan nilainya

# Koneksi PostgreSQL
DATABASE_URL=postgres://booking_user:password_kuat@localhost:5432/booking_lapangan

# Port server aplikasi (di EasyPanel, arahkan domain/proxy ke port ini)
PORT=3000

# Kunci rahasia untuk token login admin (WAJIB diganti, buat string acak panjang)
JWT_SECRET=ganti_dengan_string_acak_yang_sangat_panjang_dan_rahasia

# Folder tempat file backup database disimpan di server
BACKUP_DIR=/app/backups
